# ===== BLOCO Supply Co. — variáveis de ambiente =====
# Copie para .env e preencha. NUNCA suba o .env pro GitHub.

# Domínio público da loja (sem barra no final)
DOMAIN=sualoja.com.br
SITE_URL=https://sualoja.com.br

# Banco (o docker-compose sobe o Postgres com estes dados)
POSTGRES_USER=bloco
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=bloco
DATABASE_URL=postgresql://bloco:troque-esta-senha-forte@db:5432/bloco?schema=public

# Painel admin (/admin)
ADMIN_PASSWORD=troque-esta-senha-do-admin
# String aleatória longa (ex.: rode `openssl rand -hex 32`)
ADMIN_SECRET=

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use primeiro as credenciais de TESTE; depois troque pelas de produção.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=

# Regras comerciais
FREE_SHIPPING_CENTS=29900
SHIPPING_CENTS=2490
PIX_DISCOUNT_PERCENT=5
MAX_INSTALLMENTS=6
PIX_EXPIRATION_MINUTES=30
# Pedido não pago após X minutos devolve o estoque
ORDER_HOLD_MINUTES=120

# Onde as fotos enviadas pelo admin ficam salvas
UPLOAD_DIR=/app/uploads

# Black Friday (horário de Brasília). Fora dessas datas a loja volta ao normal sozinha.
BF_START=2026-11-27T00:00:00-03:00
BF_END=2026-11-30T23:59:59-03:00
# Desconto padrão (%) — cada produto pode ter o seu no admin (0 = fora da promoção)
BF_PERCENT=30
# Quantos dias antes mostrar a contagem regressiva e a prévia
BF_TEASER_DAYS=21
